# ---- SVM AI/ML service : environment ----
# Copy to `.env` and fill in. Never commit the real .env.

PORT=8000

# Comma-separated browser origins allowed to call this service.
# Use "*" for local development only.
ALLOWED_ORIGINS=http://localhost:5173,https://zealous-wave-0e9e7b600.1.azurestaticapps.net

# Groq API key for LLM contract generation and the chatbot.
# https://console.groq.com/keys
GROQ_API_KEY=

# Azure OpenAI Configuration
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview

